# Copy to .env and fill in real values. NEVER commit .env.
# Production (Render/Railway/Fly) sets these as service environment variables.

# --- Database ---
# Local dev without this falls back to sqlite ./medication.db.
# Production: Render internal URL, e.g. postgresql://user:pass@host/db
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/medication_db

# --- Auth ---
# REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=YOUR_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://medication-reminder-agent-ochre.vercel.app

# --- Rate limiting (login/register, per IP) ---
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Email reminders (SMTP, optional) ---
# Without these, reminders are logged + saved in-app, email is skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_GMAIL@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# --- Telegram reminders (optional) ---
# Create a bot via @BotFather, set token; each user sets their chat id
# in reminder settings (PUT /settings/reminders).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional push/SMS-style webhook (Slack/Discord/SMS gateway) ---
# POSTs JSON {"text": ...} on each reminder when set.
NOTIFICATION_WEBHOOK_URL=

# --- Optional LLM for AI advice / interactions / chat ---
# Set ONE of these; otherwise built-in local logic is used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Misc ---
APP_NAME=Medication Reminder Agent
PORT=8000

# Used by app.py (Streamlit client). Frontend uses frontend/.env VITE_API_URL.
API_URL=http://127.0.0.1:8000
